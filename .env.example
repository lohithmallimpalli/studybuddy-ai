# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Default: gemini-flash-lite-latest or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-flash-lite-latest

# API Request Timeout in seconds
GEMINI_TIMEOUT=30.0

# Flask Server Configuration (5001 recommended for macOS to avoid AirPlay conflict)
FLASK_PORT=5001
FLASK_DEBUG=False
